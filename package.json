{
  "name": "threadforge",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:updater": "tauri build --features updater --config src-tauri/tauri.updater.conf.json",
    "test": "tsc --noEmit && tsx tests/geometry.test.ts && tsx tests/embroidery_gen.ts tests/out && python3 tests/embroidery_check.py tests/out && python3 tests/embroidery_check.py tests/out/satin",
    "test:e2e": "npm run build:single && python3 tests/e2e.py \"$PWD/dist-single/index.html\" e2e-out && python3 tests/e2e_phase3.py \"$PWD/dist-single/index.html\" e2e-out && python3 tests/e2e_phase4.py \"$PWD/dist-single/index.html\" e2e-out && python3 tests/e2e_phase5.py \"$PWD/dist-single/index.html\" e2e-out"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "jspdf": "^4.2.1",
    "mp4-muxer": "^5.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
