{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "THREADFORGE",
  "version": "0.3.0",
  "identifier": "com.threadforge.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "THREADFORGE",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0B0B0E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "DesignTool",
    "shortDescription": "Clothing design and mockup studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
